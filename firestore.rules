rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /work_orders/{workOrderId} {
      allow read, write: if true;
    }

    match /equipment/{equipmentId} {
      allow read, write: if true;
    }

    match /energy_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
