// BizOS — Prisma Schema
// Auth stricte enterprise-grade: sessions, 2FA, audit, lockout

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===================== ENUMS =====================

enum Role {
  SUPER_ADMIN
  FACILITY_MANAGER
  TECHNICIAN
  CLIENT_VIEWER
}

enum LicensePlan {
  FREE
  PRO
  ENTERPRISE
}

enum LicenseStatus {
  AVAILABLE
  USED
  EXPIRED
  REVOKED
}

enum AssetCategory {
  HVAC
  ELEVATOR
  ENERGY_GRID
  SECURITY
  PLUMBING
  FIRE_SAFETY
}

enum AssetStatus {
  OPERATIONAL
  WARNING
  CRITICAL
  MAINTENANCE
}

enum WorkOrderPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  PENDING_PARTS
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum TwoFactorMethod {
  TOTP
  EMAIL
  BACKUP_CODE
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  REGISTER
  EMAIL_VERIFIED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  TWO_FA_ENABLED
  TWO_FA_DISABLED
  BACKUP_CODE_USED
  SESSION_REVOKED
  SESSIONS_REVOKED_ALL
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  SUSPICIOUS_ACTIVITY
}

// ===================== CORE =====================

model Organization {
  id           String       @id @default(uuid())
  name         String
  code         String       @unique
  contactEmail String
  contactPhone String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users        User[]
  assets       Asset[]
  licenses     LicenseKey[]
  workOrders   WorkOrder[]
  authAuditLog AuthAuditLog[]
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  passwordHash   String
  name           String
  role           Role          @default(FACILITY_MANAGER)
  isSuperAdmin   Boolean       @default(false)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // ===== AUTH SECURITY =====
  emailVerified      Boolean   @default(false)
  twoFactorEnabled   Boolean   @default(false)

  passwordChangedAt  DateTime?
  mustChangePassword Boolean   @default(false)

  failedLoginCount   Int       @default(0)
  failedLoginAt      DateTime?
  lockedUntil        DateTime?

  lastLoginAt        DateTime?
  lastLoginIp        String?

  deletedAt          DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedWorkOrders WorkOrder[]         @relation("AssignedTechnician")
  sessions           Session[]
  twoFactorSecret    TwoFactorSecret?
  passwordHistory    PasswordHistory[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  loginAttempts      LoginAttempt[]
  accountLockouts    AccountLockout[]
  authAuditLog       AuthAuditLog[]
}

// ===================== LICENSE KEYS =====================

model LicenseKey {
  id             String        @id @default(uuid())
  key            String        @unique
  plan           LicensePlan   @default(PRO)
  maxUsers       Int           @default(10)
  maxAssets      Int           @default(500)
  durationDays   Int           @default(365)
  expiresAt      DateTime
  status         LicenseStatus @default(AVAILABLE)

  usedByOrgId    String?
  organization   Organization? @relation(fields: [usedByOrgId], references: [id])
  usedAt         DateTime?
  usedByEmail    String?
  usedByName     String?

  generatedBy    String        @default("tarikbenaich@gmail.com")
  generatedAt    DateTime      @default(now())
  notes          String?

  revokedAt      DateTime?
  revokedBy      String?
  revokedReason  String?
}

// ===================== ASSETS =====================

model Asset {
  id              String        @id @default(uuid())
  code            String        @unique
  name            String
  category        AssetCategory
  location        String
  floor           String
  status          AssetStatus   @default(OPERATIONAL)
  healthScore     Int           @default(100)
  temperature     Float?
  powerUsageKw    Float?
  lastMaintenance DateTime?
  nextScheduled   DateTime?
  serialNumber    String
  vendor          String

  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])

  sensors         SensorNode[]
  workOrders      WorkOrder[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model SensorNode {
  id           String         @id @default(uuid())
  nodeId       String         @unique
  zone         String
  type         String
  currentValue String
  unit         String
  status       String         @default("ONLINE")
  lastPing     DateTime       @default(now())

  assetId      String?
  asset        Asset?         @relation(fields: [assetId], references: [id])

  telemetry    TelemetryLog[]
}

model TelemetryLog {
  id           String     @id @default(uuid())
  sensorId     String
  sensor       SensorNode @relation(fields: [sensorId], references: [id])
  metric       String
  value        Float
  unit         String
  timestamp    DateTime   @default(now())
}

model WorkOrder {
  id                   String            @id @default(uuid())
  ticketNumber         String            @unique
  title                String
  description          String
  priority             WorkOrderPriority @default(MEDIUM)
  status               WorkOrderStatus   @default(OPEN)
  location             String
  predictedFailureProb Int               @default(0)

  assetId              String
  asset                Asset             @relation(fields: [assetId], references: [id])

  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id])

  assignedToId         String?
  assignedTechnician   User?             @relation("AssignedTechnician", fields: [assignedToId], references: [id])

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

// ===================== AUTH SECURITY TABLES =====================

model Session {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String        @unique
  userAgentHash    String
  ipAddress        String?
  geoCountry       String?
  geoCity          String?
  deviceType       String?

  status           SessionStatus @default(ACTIVE)

  issuedAt         DateTime      @default(now())
  lastUsedAt       DateTime      @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?

  @@index([userId])
  @@index([status, expiresAt])
}

model TwoFactorSecret {
  id                 String          @id @default(uuid())
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  method             TwoFactorMethod @default(TOTP)
  secretEncrypted    String
  backupCodesHashed  String[]

  enabledAt          DateTime?
  lastUsedAt         DateTime?

  @@index([userId])
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordReset {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  ipAddress     String?
  userAgent     String?

  requestedAt   DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  invalidatedAt DateTime?

  @@index([userId])
}

model EmailVerification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String    @unique
  requestedAt DateTime  @default(now())
  expiresAt   DateTime
  verifiedAt  DateTime?
  ipAddress   String?

  @@index([userId, requestedAt])
}

model LoginAttempt {
  id             String    @id @default(uuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email          String?
  ipAddress      String
  success        Boolean
  failureReason  String?
  userAgent      String?
  attemptedAt    DateTime  @default(now())

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
}

model AccountLockout {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String?
  ipAddress   String?
  reason      String
  lockedAt    DateTime  @default(now())
  expiresAt   DateTime
  unlockedAt  DateTime?
  unlockedBy  String?

  @@index([email])
  @@index([expiresAt])
}

model AuthAuditLog {
  id             String        @id @default(uuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  eventType      AuthEventType
  email          String?
  ipAddress      String?
  userAgent      String?
  geoCountry     String?
  success        Boolean?
  failureReason  String?
  metadata       Json?

  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([eventType, createdAt])
  @@index([ipAddress, createdAt])
}
