// CAFM Pro - Prisma Database Schema
// Database ORM for Facility Management, Asset Tracking & License Stock Control

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  FACILITY_MANAGER
  TECHNICIAN
  CLIENT_VIEWER
}

enum LicensePlan {
  FREE
  PRO
  ENTERPRISE
}

enum LicenseStatus {
  AVAILABLE
  USED
  EXPIRED
  REVOKED
}

enum AssetCategory {
  HVAC
  ELEVATOR
  ENERGY_GRID
  SECURITY
  PLUMBING
  FIRE_SAFETY
}

enum AssetStatus {
  OPERATIONAL
  WARNING
  CRITICAL
  MAINTENANCE
}

enum WorkOrderPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  PENDING_PARTS
}

// 1. ORGANIZATIONS (Clients using CAFM Pro)
model Organization {
  id           String       @id @default(uuid())
  name         String
  code         String       @unique
  contactEmail String
  contactPhone String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users        User[]
  assets       Asset[]
  licenses     LicenseKey[]
  workOrders   WorkOrder[]
}

// 2. USERS & ADMINISTRATORS
model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  passwordHash       String
  name               String
  role               Role          @default(FACILITY_MANAGER)
  isSuperAdmin       Boolean       @default(false)
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Auth security fields
  emailVerified      Boolean       @default(false)
  twoFactorEnabled   Boolean       @default(false)
  twoFactorSecret    String?       // TOTP secret (encrypted)
  failedLoginCount   Int           @default(0)
  failedLoginAt      DateTime?
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  passwordChangedAt  DateTime?
  mustChangePassword Boolean       @default(false)
  deletedAt          DateTime?     // Soft delete

  assignedWorkOrders WorkOrder[]   @relation("AssignedTechnician")
  sessions           Session[]
  gmailConfig        GmailConfig?
  backupCodes        TwoFactorBackupCode[]
}

// 3. LICENSE KEYS (Pre-generated single-use stock keys)
model LicenseKey {
  id             String        @id @default(uuid())
  key            String        @unique // Format: CAFM-PRO-XXXX-XXXX-XXXX-XXXX
  plan           LicensePlan   @default(PRO)
  maxUsers       Int           @default(10)
  maxAssets      Int           @default(500)
  durationDays   Int           @default(365)
  expiresAt      DateTime
  status         LicenseStatus @default(AVAILABLE)

  usedByOrgId    String?
  organization   Organization? @relation(fields: [usedByOrgId], references: [id])
  usedAt         DateTime?
  usedByEmail    String?
  usedByName     String?

  generatedBy    String        @default("tarikbenaich@gmail.com")
  generatedAt    DateTime      @default(now())
  notes          String?

  revokedAt      DateTime?
  revokedBy      String?
  revokedReason  String?
}

// 4. ASSETS (Equipment, Chillers, Elevators, Transformers)
model Asset {
  id              String        @id @default(uuid())
  code            String        @unique // e.g. HVAC-NORTH-01
  name            String
  category        AssetCategory
  location        String
  floor           String
  status          AssetStatus   @default(OPERATIONAL)
  healthScore     Int           @default(100)
  temperature     Float?
  powerUsageKw    Float?
  lastMaintenance DateTime?
  nextScheduled   DateTime?
  serialNumber    String
  vendor          String

  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])

  sensors         SensorNode[]
  workOrders      WorkOrder[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// 5. IOT SENSOR NODES
model SensorNode {
  id           String         @id @default(uuid())
  nodeId       String         @unique // e.g. NODE-A1-TEMP
  zone         String
  type         String         // TEMP_HUMIDITY, CO2_AIR_QUALITY, VIBRATION, ENERGY_METER
  currentValue String
  unit         String
  status       String         @default("ONLINE")
  lastPing     DateTime       @default(now())

  assetId      String?
  asset        Asset?         @relation(fields: [assetId], references: [id])

  telemetry    TelemetryLog[]
}

// 6. TELEMETRY LOGS (Time-series data)
model TelemetryLog {
  id           String     @id @default(uuid())
  sensorId     String
  sensor       SensorNode @relation(fields: [sensorId], references: [id])
  metric       String     // temperature, vibration_rms, power_kw, co2_ppm
  value        Float
  unit         String
  timestamp    DateTime   @default(now())
}

// 7. GMAO WORK ORDERS (Maintenance Tickets)
model WorkOrder {
  id                   String            @id @default(uuid())
  ticketNumber         String            @unique // e.g. WO-2026-881
  title                String
  description          String
  priority             WorkOrderPriority @default(MEDIUM)
  status               WorkOrderStatus   @default(OPEN)
  location             String
  predictedFailureProb Int               @default(0) // AI probability %

  assetId              String
  asset                Asset             @relation(fields: [assetId], references: [id])

  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id])

  assignedToId         String?
  assignedTechnician   User?             @relation("AssignedTechnician", fields: [assignedToId], references: [id])

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// 8. SESSIONS (Multi-device Auth)
model Session {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash   String
  userAgentHash      String?
  ipAddress          String?
  geoCountry         String?
  deviceType         String?
  status             SessionStatus @default(ACTIVE)
  
  issuedAt           DateTime      @default(now())
  lastUsedAt         DateTime      @default(now())
  expiresAt          DateTime
  
  revokedAt          DateTime?
  revokedReason      String?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
  @@index([refreshTokenHash])
}

// 9. GMAIL CONFIG (Per-User Integration)
model GmailConfig {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  gmailEmail            String?
  isActive              Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ==========================================
// AUTH SECURITY MODELS
// ==========================================

enum AuthEventType {
  REGISTER
  EMAIL_VERIFIED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  SESSIONS_REVOKED_ALL
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FA_ENABLED
  TWO_FA_DISABLED
  BACKUP_CODE_USED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  SUSPICIOUS_ACTIVITY
}

// Audit log immutable de tous les événements auth
model AuthAuditLog {
  id             String        @id @default(uuid())
  eventType      AuthEventType
  userId         String?
  organizationId String?
  email          String?
  ipAddress      String?
  userAgent      String?
  geoCountry     String?
  success        Boolean       @default(true)
  failureReason  String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

// Tentatives de connexion (par IP/email pour le lockout)
model LoginAttempt {
  id            String   @id @default(uuid())
  userId        String?
  email         String
  ipAddress     String
  userAgent     String?
  success       Boolean
  failureReason String?
  attemptedAt   DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([attemptedAt])
}

// Verrouillage de compte
model AccountLockout {
  id          String    @id @default(uuid())
  userId      String?
  email       String
  ipAddress   String?
  reason      String
  expiresAt   DateTime
  unlockedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

// Vérification d'email
model EmailVerification {
  id          String    @id @default(uuid())
  userId      String
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  verifiedAt  DateTime?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// Réinitialisation de mot de passe
model PasswordReset {
  id             String    @id @default(uuid())
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  invalidatedAt  DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// Historique des mots de passe (anti-réutilisation)
model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId])
}

// Codes de secours 2FA
model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Secrets TOTP 2FA (un par utilisateur)
model TwoFactorSecret {
  id                  String    @id @default(uuid())
  userId              String    @unique
  method              String    @default("TOTP")
  secretEncrypted     String
  backupCodesHashed   String[]
  enabledAt           DateTime?
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
}
